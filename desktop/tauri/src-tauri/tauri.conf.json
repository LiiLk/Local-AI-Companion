{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Local AI Companion Desktop",
  "version": "0.2.0",
  "identifier": "com.khalil.localaicompanion.desktop",
  "build": {
    "beforeDevCommand": "npm run dev:web",
    "beforeBuildCommand": "npm run build:web",
    "beforeBundleCommand": "python3 ../scripts/build_sidecar.py",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        "main"
      ],
      "csp": null
    },
    "windows": [
      {
        "label": "main",
        "title": "Local AI Companion",
        "width": 840,
        "height": 720,
        "minWidth": 800,
        "minHeight": 700,
        "resizable": true,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": true,
        "skipTaskbar": true,
        "shadow": false,
        "dragDropEnabled": false
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "icon": [
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      }
    }
  }
}
